# Saytning tashqi manzili (https). Telegram Login Widget faqat BotFather'da
# /setdomain bilan ko'rsatilgan domenda ishlaydi — localhost'da ishlamaydi.
BASE_URL=https://watcher.example.uz

# @BotFather'dan. Kirish ham, bildirishnomalar ham shu bot orqali.
TELEGRAM_BOT_TOKEN=

# SQLite fayli (default: ${DATA_DIR}/watcher.db, ya'ni ./data/watcher.db)
# DATABASE_PATH=./data/watcher.db

# Ixtiyoriy
MAX_SEARCHES_PER_CYCLE=30
MAX_WATCHES_PER_USER=10
# Adminlarning Telegram ID'lari (vergul bilan). ID'ni bilish: @userinfobot ga yozing.
# Adminlar /admin/polling sahifasida tekshiruv oraliqlari jadvalini boshqaradi.
ADMIN_TELEGRAM_IDS=
