# Tashqi manzil. Productionda https bo'lishi shart (cookie'lar shunda Secure bo'ladi).
BASE_URL=http://localhost:8080

# @BotFather'dan. Majburiy: saytga kirish va xabarnomalar shu bot orqali
TELEGRAM_BOT_TOKEN=

# SQLite fayli (default: ${DATA_DIR}/watcher.db, ya'ni ./data/watcher.db)
# DATABASE_PATH=./data/watcher.db

# Ixtiyoriy
MAX_SEARCHES_PER_CYCLE=30
MAX_WATCHES_PER_USER=10
# Tekshiruv loglarini necha kun saqlash (0 = o'chirmaslik)
LOG_RETENTION_DAYS=14
# Tekshiruv oraliqlari jadvalini shu adminlar /admin/polling sahifasida boshqaradi
ADMIN_TELEGRAM_IDS=
