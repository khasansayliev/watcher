# Tashqi manzil (OAuth redirect shundan yasaladi). Productionda https bo'lishi shart.
BASE_URL=http://localhost:8080

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# @BotFather'dan
TELEGRAM_BOT_TOKEN=

# docker-compose ishlatmasangiz:
# DATABASE_URL=postgres://user:pass@localhost:5432/watcher?sslmode=disable

# Ixtiyoriy
POLL_INTERVAL=10s
MAX_SEARCHES_PER_CYCLE=30
MAX_WATCHES_PER_USER=10
ADMIN_EMAILS=
